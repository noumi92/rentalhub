rules_version = '2';

// ---------------------------------------------------------------------------
// RentalHub Comprehensive Firestore Security Rules
// Project: rentalhub-dev-pk
//
// Role-based Access Control (RBAC):
//  - Customers (Online): Self-managed profile, online bookings, payments.
//  - Showrooms (Owners): Complete autonomy over their fleet, walk-in CRM,
//    operations, agreements, and isolated financial ledger.
//  - Admin Roles:
//     * super_admin: Full platform administration, invites, CNIC QR codes.
//     * operations: Showroom accreditation, fleet review, disputes, tribunal.
//     * support: Triage disputes & tickets (read-only for financials).
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Helper Functions
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return request.auth.token.get('role', '') != ''
        ? request.auth.token.get('role', '')
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? getUserData().get('role', '')
            : '');
    }

    function isOwner() {
      return isSignedIn() && userRole() == 'owner';
    }

    function adminRole() {
      return isSignedIn() && (
        request.auth.token.get('admin_role', '') in ['super_admin', 'operations', 'support'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().get('admin_role', '') in ['super_admin', 'operations', 'support'])
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin_role', '') == 'super_admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().get('admin_role', '') == 'super_admin')
      );
    }

    function isAdminOps() {
      return isSignedIn() && (
        request.auth.token.get('admin_role', '') in ['super_admin', 'operations'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().get('admin_role', '') in ['super_admin', 'operations'])
      );
    }

    function isShopOwner(shopId) {
      return isSignedIn() && (
        shopId == request.auth.uid ||
        shopId == 'shop_' + request.auth.uid ||
        (shopId != '' && exists(/databases/$(database)/documents/shops/$(shopId)) &&
          (get(/databases/$(database)/documents/shops/$(shopId)).data.get('owner_id', '') == request.auth.uid ||
           get(/databases/$(database)/documents/shops/$(shopId)).data.get('ownerId', '') == request.auth.uid))
      );
    }

    // Phase 1 (1.6): the walk-in customer's owning shop, for the
    // customer_qr_codes write rule — the customer record must exist
    // and name the writer's shop (the owner files the QR number
    // they collected; the customer record is saved first).
    function isCustomerShopOwner(customerId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/customers/$(customerId))
        && (isShopOwner(get(/databases/$(database)/documents/customers/$(customerId)).data.get('shopId', ''))
          || isShopOwner(get(/databases/$(database)/documents/customers/$(customerId)).data.get('shop_id', '')));
    }

    // Phase 1 (1.6): a party to the booking a notification is
    // about, for the notifications create rule — a customer
    // notifies the shop of a new booking, a dispute, or a review
    // (booking_remote_data_source, dispute_remote_data_source,
    // review_remote_data_source), and the writer is that booking's
    // customer.
    function isNotificationBookingParty(bookingId) {
      return isSignedIn()
        && bookingId != ''
        && exists(/databases/$(database)/documents/bookings/$(bookingId))
        && (get(/databases/$(database)/documents/bookings/$(bookingId)).data.get('customerId', '') == request.auth.uid
          || get(/databases/$(database)/documents/bookings/$(bookingId)).data.get('customer_id', '') == request.auth.uid);
    }

    // =========================================================================
    // 1. Identity & Profile Collections
    // =========================================================================

    // Online Users: Accounts belong to individual users.
    // Client cannot escalate admin roles, blacklist flags, or trust scores.
    match /users/{userId} {
      allow get: if isUser(userId) || adminRole();
      allow list: if adminRole();
      allow create: if isUser(userId)
        && !('admin_role' in request.resource.data)
        && !('totp_enabled' in request.resource.data);
      allow update: if (isUser(userId)
        && !('admin_role' in request.resource.data)
        && !('totp_enabled' in request.resource.data)
        && (!('role' in resource.data) || !('role' in request.resource.data) || resource.data.role == request.resource.data.role))
        || isSuperAdmin();
      allow delete: if isUser(userId) || isSuperAdmin();
    }

    // TOTP Secrets: Deny all from client (Cloud Functions Admin SDK only)
    match /admin_secrets/{uid} {
      allow read, write: if false;
    }

    // Super Admin Team Invites
    match /admin_invites/{inviteId} {
      allow read, write: if isSuperAdmin();
    }

    match /admin_totp_reminders/{id} {
      allow read, write: if isSuperAdmin();
    }

    // Immutable Platform Audit Logs
    match /audit_logs/{logId} {
      allow read: if adminRole();
      // Phase 1 (1.6): create was open to any signed-in user — only
      // an admin may log an admin action. Every client-side caller
      // is an admin flow (AdminAuditService.logAction); Cloud
      // Functions write with the Admin SDK and bypass rules.
      allow create: if adminRole();
      allow update, delete: if false;
    }

    // Restricted CNIC Back-QR Numbers: Super Admin ONLY (read).
    // Phase 1 (1.6): create/update were open to any signed-in user
    // for any customer's doc. Writes are now the super admin, the
    // customer themself (their own KYC submission), or the owning
    // shop (walk-in KYC filed by the shop) — the three legitimate
    // writers (CustomerQrCodeService). The customerId must match
    // the doc and the QR value must be a string, as before.
    match /customer_qr_codes/{customerId} {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin()
        || (isUser(customerId)
          && request.resource.data.get('customerId', '') == customerId
          && request.resource.data.get('qrCode', '') is string)
        || (isSignedIn()
          && request.resource.data.get('customerId', '') == customerId
          && request.resource.data.get('qrCode', '') is string
          && isCustomerShopOwner(customerId));
      allow delete: if false;
    }

    // =========================================================================
    // 2. Showroom & Fleet Discovery
    // =========================================================================

    // Showrooms: Public discovery; owned by specific showroom owner
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.get('owner_id', '') == request.auth.uid ||
        request.resource.data.get('ownerId', '') == request.auth.uid ||
        isShopOwner(shopId)
      );
      allow update: if isShopOwner(shopId) || isAdminOps();
      allow delete: if isAdminOps();
    }

    // Vehicles: Public discovery; managed exclusively by showroom owner
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isAdminOps()
      );
      allow update, delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shop_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isAdminOps()
      );
    }

    // Fixed Intercity Routes
    match /fixed_routes/{routeId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
      allow update, delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
    }

    // Car Reviews (Admin Approval/Decision)
    match /car_reviews/{vehicleId} {
      allow read: if adminRole() ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', ''));
      allow create, update: if isAdminOps();
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 3. Customer CRM: Walk-in Customers (Showroom Property) & Online KYC
    // =========================================================================

    // Walk-in Customers: Strictly the property of the specific showroom.
    // The owning showroom has COMPLETE CRUD and KYC replace autonomy.
    // Cross-showroom access is strictly forbidden.
    match /customers/{customerId} {
      allow read: if (
        isUser(customerId) ||
        (resource != null && (
          isShopOwner(resource.data.get('shopId', '')) ||
          isShopOwner(resource.data.get('shop_id', ''))
        )) ||
        adminRole()
      );
      allow create: if (
        isUser(customerId) ||
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
      allow update: if (
        isUser(customerId) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
      allow delete: if (
        isUser(customerId) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isAdminOps()
      );

      match /admin_notes/{noteId} {
        allow read, create: if adminRole();
      }
    }

    // KYC Verification Documents
    match /kyc_documents/{customerId} {
      allow get: if isSignedIn() && (
        resource == null ||
        isUser(customerId) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        (isOwner() &&
          resource.data.get('shopId', '') == '' &&
          resource.data.get('shop_id', '') == '') ||
        adminRole()
      );
      allow list: if isSignedIn() && (
        isUser(customerId) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      allow create: if isSignedIn() && (
        isUser(customerId) ||
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
      allow update: if isSignedIn() && (
        isUser(customerId) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
      allow delete: if isUser(customerId) || isAdminOps();
    }

    // =========================================================================
    // 4. Booking Engine & Field Operations
    // =========================================================================

    // PII-free Vehicle Availability Slots (allows customer calendar checks)
    match /vehicle_booked_slots/{bookingId} {
      allow read: if true;
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'bookingId', 'vehicleId', 'shopId', 'pickupTime', 'returnTime', 'status', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isAdminOps()
      );
    }

    // Bookings: Online customers and Showroom owners (walk-ins)
    match /bookings/{bookingId} {
      function isBookingCustomer(data) {
        return isSignedIn() && (
          request.auth.uid == data.get('customer_id', '') ||
          request.auth.uid == data.get('customerId', '')
        );
      }

      function isBookingShopOwner(data) {
        return isShopOwner(data.get('shop_id', '')) ||
          isShopOwner(data.get('shopId', ''));
      }

      function customerCoreFieldsUnchanged() {
        return request.resource.data.get('totalAmount', 0) == resource.data.get('totalAmount', 0) &&
          request.resource.data.get('advancePaid', 0) == resource.data.get('advancePaid', 0) &&
          request.resource.data.get('advanceRequired', 0) == resource.data.get('advanceRequired', 0) &&
          request.resource.data.get('remainingBalance', 0) == resource.data.get('remainingBalance', 0) &&
          request.resource.data.get('shopId', '') == resource.data.get('shopId', '') &&
          request.resource.data.get('vehicleId', '') == resource.data.get('vehicleId', '') &&
          request.resource.data.get('customerId', '') == resource.data.get('customerId', '');
      }

      allow get: if isSignedIn() && (
        resource == null ||
        isBookingCustomer(resource.data) ||
        isBookingShopOwner(resource.data) ||
        adminRole()
      );
      allow list: if isSignedIn() && (
        isBookingCustomer(resource.data) ||
        isBookingShopOwner(resource.data) ||
        adminRole()
      );
      allow create: if isSignedIn() && (
        isBookingShopOwner(request.resource.data) ||
        isAdminOps() ||
        (isBookingCustomer(request.resource.data) &&
          request.resource.data.get('status', 'requested') == 'requested' &&
          request.resource.data.get('advancePaid', 0) == 0 &&
          request.resource.data.get('origin', 'online') == 'online')
      );
      allow update: if isSignedIn() && (
        isBookingShopOwner(resource.data) ||
        isAdminOps() ||
        (isBookingCustomer(resource.data) && customerCoreFieldsUnchanged() && (
          // Customer submits payment proof on approved / payment_rejected booking
          (resource.data.get('status', '') in ['approved', 'payment_rejected'] &&
            request.resource.data.get('status', '') == 'payment_submitted') ||
          // Customer cancels before payment verification
          (resource.data.get('status', '') in ['requested', 'approved', 'payment_rejected'] &&
            request.resource.data.get('status', '') == 'cancelled') ||
          // Customer marks completed trip as rated
          (resource.data.get('status', '') == 'completed' &&
            request.resource.data.get('status', '') == 'completed' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerRated', 'updatedAt']))
        ))
      );
      allow delete: if isSignedIn() && (
        isBookingShopOwner(resource.data) ||
        isAdminOps()
      );
    }

    // Booking General & Driver Settings
    match /booking_settings/{shopId} {
      allow read: if isSignedIn();
      allow write: if isShopOwner(shopId) || isAdminOps();
    }

    // Legal Digital Rental Agreements
    match /agreements/{agreementId} {
      allow get: if isSignedIn() && (
        resource == null ||
        isUser(resource.data.get('customer_id', '')) ||
        isUser(resource.data.get('customerId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        adminRole()
      );
      allow list: if isSignedIn() && (
        isUser(resource.data.get('customer_id', '')) ||
        isUser(resource.data.get('customerId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        adminRole()
      );
      allow create: if isSignedIn() && (
        isUser(request.resource.data.get('customer_id', '')) ||
        isUser(request.resource.data.get('customerId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isAdminOps()
      );
      allow update, delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shop_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isAdminOps()
      );
    }

    // Handover & Return Field Records
    match /handovers/{handoverId} {
      allow get: if isSignedIn() && (
        resource == null ||
        isUser(resource.data.get('customerId', '')) ||
        isUser(resource.data.get('customer_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      allow list: if isSignedIn() && (
        isUser(resource.data.get('customerId', '')) ||
        isUser(resource.data.get('customer_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
      allow update, delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
    }

    match /return_settlements/{settlementId} {
      allow get: if isSignedIn() && (
        resource == null ||
        isUser(resource.data.get('customerId', '')) ||
        isUser(resource.data.get('customer_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      allow list: if isSignedIn() && (
        isUser(resource.data.get('customerId', '')) ||
        isUser(resource.data.get('customer_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
      allow update, delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
    }

    match /return_damage_reports/{reportId} {
      allow get: if isSignedIn() && (
        resource == null ||
        isUser(resource.data.get('customerId', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      allow list: if isSignedIn() && (
        isUser(resource.data.get('customerId', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
      allow update: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
      allow delete: if isAdminOps();
    }

    match /return_extra_charges/{chargeId} {
      allow get: if isSignedIn() && (
        resource == null ||
        isUser(resource.data.get('customerId', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      allow list: if isSignedIn() && (
        isUser(resource.data.get('customerId', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
      allow update: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
      allow delete: if isAdminOps();
    }

    // Customer Security Deposit
    match /security_deposits/{depositId} {
      allow get: if isSignedIn() && (
        resource == null ||
        isUser(resource.data.get('customerId', '')) ||
        isUser(resource.data.get('customer_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      allow list: if isSignedIn() && (
        isUser(resource.data.get('customerId', '')) ||
        isUser(resource.data.get('customer_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
      allow update, delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isAdminOps()
      );
    }

    // =========================================================================
    // 5. Showroom Financial Ledger & Back-Office (Strict Isolation)
    // =========================================================================

    match /finance_accounts/{id} {
      allow get: if isSignedIn() && (
        resource == null ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow list: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow update, delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
    }

    match /finance_transfers/{id} {
      allow get: if isSignedIn() && (
        resource == null ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow list: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow update, delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
    }

    match /cash_closings/{id} {
      allow get: if isSignedIn() && (
        resource == null ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow list: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow update, delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
    }

    match /finance_categories/{id} {
      allow get: if isSignedIn() && (
        resource == null ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow list: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow update, delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
    }

    match /finance_settings/{shopId} {
      allow read, write: if isShopOwner(shopId) || isSuperAdmin();
    }

    match /partner_shares/{id} {
      allow get: if isSignedIn() && (
        resource == null ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow list: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow update, delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
    }

    match /staff/{id} {
      allow get: if isSignedIn() && (
        resource == null ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow list: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && (
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isShopOwner(request.resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
      allow update, delete: if isSignedIn() && (
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isSuperAdmin()
      );
    }

    // =========================================================================
    // 6. Blacklist, Disputes & Reviews
    // =========================================================================

    // National Fraud Blacklist Registry
    match /blacklist/{recordId} {
      allow read: if isOwner() || adminRole() || (
        isSignedIn() && (
          resource.data.get('customer_uid', '') == request.auth.uid ||
          (resource.data.get('cnic_number', '') != '' &&
           resource.data.get('cnic_number', '') == getUserData().get('cnic_number', ''))
        )
      );
      allow create: if isOwner() || isAdminOps();
      allow update: if isAdminOps() ||
        (isOwner() && isShopOwner(resource.data.get('reported_by_shop_id', '')));
      allow delete: if isAdminOps();
    }

    // Arbitration Disputes
    match /disputes/{disputeId} {
      allow read: if isUser(resource.data.get('complainant_uid', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        adminRole();
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.get('complainant_uid', '');
      allow update: if isUser(resource.data.get('complainant_uid', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isAdminOps() ||
        (adminRole() && request.resource.data.get('status', '') == 'in_review');
      allow delete: if isSuperAdmin();
    }

    // Dual-Sided Public Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.auth.uid == request.resource.data.get('reviewer_uid', '') ||
        request.auth.uid == request.resource.data.get('customerId', '') ||
        isShopOwner(request.resource.data.get('shopId', ''))
      );
      allow update: if isAdminOps() || (
        isSignedIn() && (
          request.auth.uid == resource.data.get('customerId', '') ||
          isShopOwner(resource.data.get('shopId', ''))
        )
      );
      allow delete: if isAdminOps();
    }

    // =========================================================================
    // 7. Platform Governance, Messaging & Tickets
    // =========================================================================

    match /platform_settings/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOps();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdminOps();
    }

    match /support_tickets/{ticketId} {
      allow read: if isUser(resource.data.get('customer_id', '')) ||
        isUser(resource.data.get('userId', '')) ||
        adminRole();
      allow create: if isSignedIn();
      allow update: if adminRole() && (
        request.resource.data.get('status', '') != 'closed' || isAdminOps()
      );

      match /replies/{replyId} {
        allow read, create: if isSignedIn();
      }

      match /internal_notes/{noteId} {
        allow read, create: if adminRole();
      }
    }

    // In-App Notifications (Customers & Showroom Owners)
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (
        resource == null ||
        isUser(resource.data.get('customerId', '')) ||
        isUser(resource.data.get('recipientUid', '')) ||
        isUser(resource.data.get('recipient_uid', '')) ||
        isUser(resource.data.get('recipientId', '')) ||
        isUser(resource.data.get('userId', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      allow list, update, delete: if isSignedIn() && (
        isUser(resource.data.get('customerId', '')) ||
        isUser(resource.data.get('recipientUid', '')) ||
        isUser(resource.data.get('recipient_uid', '')) ||
        isUser(resource.data.get('recipientId', '')) ||
        isUser(resource.data.get('userId', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole()
      );
      // Phase 1 (1.6): create was open to any signed-in user, so
      // anyone could drop a notification into anyone's inbox.
      // The writers are: an admin (admin flows), the owning shop
      // (owner-to-customer), the recipient themself, or a party to
      // the booking the notification is about (customer-to-shop).
      // Cloud Functions write with the Admin SDK and bypass rules.
      allow create: if adminRole()
        || isShopOwner(request.resource.data.get('shopId', ''))
        || isUser(request.resource.data.get('customerId', ''))
        || isUser(request.resource.data.get('recipientUid', ''))
        || isNotificationBookingParty(
            request.resource.data.get('bookingId', ''));
    }

    // Showroom Subscriptions
    match /subscription_requests/{requestId} {
      allow read: if isShopOwner(resource.data.get('shop_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        adminRole();
      allow create: if isShopOwner(request.resource.data.get('shop_id', '')) ||
        isShopOwner(request.resource.data.get('shopId', '')) ||
        isAdminOps();
      allow update: if isAdminOps();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isShopOwner(resource.data.get('shop_id', '')) ||
        isShopOwner(resource.data.get('shopId', '')) ||
        adminRole();
      allow create, update: if isAdminOps();
      allow delete: if isSuperAdmin();
    }

    // WhatsApp Credits, Settings & Audit Logs
    match /whatsapp_credits/{shopId} {
      allow read: if isShopOwner(shopId) || adminRole();
      allow write: if isShopOwner(shopId) || isAdminOps();
    }

    match /whatsapp_settings/{shopId} {
      allow read, write: if isShopOwner(shopId) || adminRole();
    }

    match /whatsapp_dispatch_logs/{logId} {
      allow read: if isShopOwner(resource.data.get('shopId', '')) ||
        isShopOwner(resource.data.get('shop_id', '')) ||
        adminRole();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /whatsapp_skipped_messages/{id} {
      allow read: if isShopOwner(resource.data.get('shopId', '')) || adminRole();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /credit_purchase_requests/{id} {
      allow read: if isShopOwner(resource.data.get('shopId', '')) || adminRole();
      allow create: if isShopOwner(request.resource.data.get('shopId', '')) || isAdminOps();
      allow update: if isAdminOps();
    }

  }
}
